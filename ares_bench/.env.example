# ARES-Bench Environment Configuration

# Mode: set to "true" to run without Docker services
SIMULATION_MODE=true

# PostgreSQL
POSTGRES_USER=ares
POSTGRES_PASSWORD=ares_bench
POSTGRES_DB=ares_bench
POSTGRES_DSN=postgresql://ares:ares_bench@postgres:5432/ares_bench

# Redis
REDIS_URL=redis://redis:6379/0

# OpenSearch
OPENSEARCH_URL=https://opensearch:9200
OPENSEARCH_INITIAL_ADMIN_PASSWORD=AresBench!2024

# Ollama (LLM backend)
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=mistral:7b

# Service ports
SCENARIO_ENGINE_PORT=8001
MISMATCH_INJECTOR_PORT=8002
LANGGRAPH_AGENT_PORT=8003
AUTOGEN_AGENT_PORT=8004
CREWAI_AGENT_PORT=8005
ANOMALY_MONITOR_PORT=8006
DATASET_WRITER_PORT=8007
RULEBASED_AGENT_PORT=8008
ORCHESTRATOR_PORT=8010

# Experiment parameters
RANDOM_SEED=42
NUM_REPETITIONS=3
OUTPUT_DIR=output

# Simulation parameters
SIM_NOISE_STD=0.02
SIM_LATENCY_BASE_MS=150.0
